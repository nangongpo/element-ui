{
  "name": "Element Theme Roller",
  "version": "1.0.0",
  "description": "Customize all Design Tokens of Element UI and preview in real-time",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_icon": "icon.png",
    "default_title": "Element Theme Roller"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://nangongpo.github.io/element-ui/*"],
  "web_accessible_resources": [
    {
      "resources": ["entry.js", "static/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
